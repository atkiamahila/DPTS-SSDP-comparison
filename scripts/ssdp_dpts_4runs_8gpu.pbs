#!/bin/bash -l
#PBS -N ssdp_dpts_8gpu
#PBS -q preemptable
#PBS -r y
#PBS -A VeloC
#PBS -l select=2:system=polaris:ngpus=4
#PBS -l walltime=09:30:00
#PBS -l filesystems=home:grand:eagle
#PBS -l place=scatter

set -euo pipefail

cd "$PBS_O_WORKDIR"
LOGDIR="$PBS_O_WORKDIR/runlogs"
mkdir -p "$LOGDIR"
PBSLOG="$LOGDIR/ssdp_dpts_8gpu.${PBS_JOBID}.log"
exec > >(tee -a "$PBSLOG") 2>&1

echo "[LOG]   $PBSLOG"
echo "[JOBID] $PBS_JOBID"
echo "[TIME]  $(date -Is)"
echo "[HEAD]  $(hostname)"
echo "[NODES]"
sort -u "$PBS_NODEFILE"

module use /soft/modulefiles
module load conda
conda activate ssdp-paper

export HF_HOME=/lus/grand/projects/VeloC/atkia/hf_cache
export TRANSFORMERS_CACHE="$HF_HOME"
export HF_HUB_CACHE="$HF_HOME"
export HUGGINGFACE_HUB_CACHE="$HF_HOME"
export HF_TOKEN="$(cat $HOME/.secrets/hf_token)"
export HUGGINGFACE_HUB_TOKEN="$HF_TOKEN"

export CUDA_DEVICE_ORDER=PCI_BUS_ID
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

REPO=/lus/grand/projects/VeloC/atkia/ssdp/SSDP
cd "$REPO"

echo "[PWD] $(pwd)"

cat > "$LOGDIR/launch_${PBS_JOBID}.sh" <<'EOF'
#!/bin/bash
set -euo pipefail

RANK="${PMI_RANK:-0}"
HOST="$(hostname)"
SLOT=$(( RANK % 2 ))

LOGDIR="${LOGDIR:?LOGDIR not set}"
REPO="${REPO:?REPO not set}"
JOBID="${PBS_JOBID:?PBS_JOBID not set}"

cd "$REPO"
export BENCHMARK_ROOT='./benchmark'
export CUDA_DEVICE_ORDER=PCI_BUS_ID

# Two processes per node:
# slot 0 gets physical GPUs 0,1
# slot 1 gets physical GPUs 2,3
if [[ "$SLOT" == "0" ]]; then
  export CUDA_VISIBLE_DEVICES=0,1
elif [[ "$SLOT" == "1" ]]; then
  export CUDA_VISIBLE_DEVICES=2,3
else
  echo "[ERROR] Unexpected SLOT=$SLOT on $HOST"
  exit 1
fi

# case "$RANK" in
#   0)
#     CFG="configs/inference/DPTS.json"
#     MODEL="llama-3b"
#     EXP="DPTS_math_llama-3b_2gpu"
#     TAG="llama-3b_DPTS"
#     ;;
#   1)
#     CFG="configs/inference/SSDP.json"
#     MODEL="llama-3b"
#     EXP="SSDP_math_llama-3b_2gpu"
#     TAG="llama-3b_SSDP"
#     ;;
#   2)
#     CFG="configs/inference/DPTS.json"
#     MODEL="llama-8b"
#     EXP="DPTS_math_llama-8b_2gpu"
#     TAG="llama-8b_DPTS"
#     ;;
#   3)
#     CFG="configs/inference/SSDP.json"
#     MODEL="llama-8b"
#     EXP="SSDP_math_llama-8b_2gpu"
#     TAG="llama-8b_SSDP"
#     ;;
#   *)
#     echo "[ERROR] Unexpected RANK=$RANK"
#     exit 1
#     ;;
# esac

case "$RANK" in
    0)
     CFG="configs/inference/DPTS.json"
     MODEL="llama-8b"
     EXP="DPTS_math_llama-8b_2gpu"
     TAG="llama-8b_DPTS"
     ;;
    *)
     echo "[ERROR] Unexpected RANK=$RANK"
     exit 1
     ;;

esac



RUNLOG="$LOGDIR/${TAG}.${JOBID}.rank${RANK}.${HOST}.log"
TRACE_DIR="./results/${MODEL}/${EXP}/${JOBID}_traces"
WORK_DIR="./results"
DATASET_NAME="math"
REWARD_MODEL="mistral_prm-7b"

mkdir -p "./results/${MODEL}/${EXP}"
mkdir -p "$TRACE_DIR"

{
  echo "[START] $(date -Is)"
  echo "[HOST]  $HOST"
  echo "[RANK]  $RANK"
  echo "[SLOT]  $SLOT"
  echo "[CUDA_VISIBLE_DEVICES] $CUDA_VISIBLE_DEVICES"

  python3 - <<'PY'
import os, torch
print("CUDA_VISIBLE_DEVICES =", os.environ.get("CUDA_VISIBLE_DEVICES"))
print("torch.cuda.is_available() =", torch.cuda.is_available())
print("torch.cuda.device_count() =", torch.cuda.device_count())
for i in range(torch.cuda.device_count()):
    print(f"visible cuda:{i} ->", torch.cuda.get_device_name(i))
PY

  # Prevent Accelerate from thinking this is a multinode distributed launch.
  unset PMI_RANK PMI_SIZE PMI_FD
  unset PMIX_RANK PMIX_SERVER_URI2 PMIX_SERVER_URI3
  unset OMPI_COMM_WORLD_RANK OMPI_COMM_WORLD_SIZE OMPI_COMM_WORLD_LOCAL_RANK
  unset MPI_LOCALRANKID MPI_LOCALNRANKS
  unset MPICH_RANK MPICH_LOCAL_RANK MPICH_WORLD_SIZE
  unset MASTER_ADDR MASTER_PORT RANK WORLD_SIZE LOCAL_RANK

  python3 -u main.py \
    --config "$CFG" \
    --work-dir "$WORK_DIR" \
    --exp-name "$EXP" \
    --data "$DATASET_NAME" \
    --model "$MODEL" \
    --reward_model "$REWARD_MODEL" \
    --trace-log-dir "$TRACE_DIR" \
    --dtype bfloat16 \
    --debug

  RC=$?
  echo "[END] $(date -Is) rc=$RC"
  exit $RC
} > "$RUNLOG" 2>&1
EOF

chmod +x "$LOGDIR/launch_${PBS_JOBID}.sh"

export LOGDIR
export REPO

echo "[LAUNCH] 4 independent runs total, 2 per node, each run sees 2 GPUs"
mpiexec -n 4 --ppn 2 "$LOGDIR/launch_${PBS_JOBID}.sh"

RC=$?
echo "[DONE] $(date -Is) rc=$RC"
exit $RC
